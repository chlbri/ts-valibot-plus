{
  "name": "core-tests",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Unit and type tests for @bemedev/valibot",
  "scripts": {
    "test": "pnpm run test:coverage --no-coverage",
    "test:only": "pnpm run test:coverage --no-coverage",
    "test:coverage": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "_lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint": "pnpm run fmt && pnpm run lint:fix",
    "p-q": "pretty-quick",
    "posttest": "exit 0",
    "_ci": "pnpm run lint && pnpm run test"
  },
  "devDependencies": {
    "@bemedev/dev-utils": "^1.5.0",
    "@bemedev/valibot-extended": "workspace:^",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vitest": "^5.0.3"
  }
}
